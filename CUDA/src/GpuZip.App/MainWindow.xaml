<Window x:Class="GpuZip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPUZIP"
        Width="1240"
        Height="780"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,16" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="14" Padding="12,6">
                    <TextBlock x:Name="CudaStatusText" Text="CUDA optional · CPU fallback" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <StackPanel>
                    <TextBlock Text="GPUZIP" FontSize="25" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="Universal archives and adaptive GPU compression" Foreground="#6B7280" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="20,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Open archive" Click="OpenArchive_Click" />
                    <Button Content="Add files" Click="AddFiles_Click" />
                    <Button Content="Add folder" Click="AddFolder_Click" />
                    <Button Content="Create archive" Click="CreateArchive_Click" />
                    <Button Content="Extract" Click="Extract_Click" />
                    <Button Content="Test" Click="Test_Click" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="FormatComboBox" Width="180" SelectedIndex="0" Margin="0,0,12,0">
                        <ComboBoxItem Content="GPUZIP (.gpuz)" Tag="gpuz" />
                        <ComboBoxItem Content="7-Zip (.7z)" Tag="7z" />
                        <ComboBoxItem Content="ZIP (.zip)" Tag="zip" />
                        <ComboBoxItem Content="TAR (.tar)" Tag="tar" />
                        <ComboBoxItem Content="GZip (.gz)" Tag="gzip" />
                        <ComboBoxItem Content="BZip2 (.bz2)" Tag="bzip2" />
                        <ComboBoxItem Content="XZ (.xz)" Tag="xz" />
                    </ComboBox>
                    <CheckBox x:Name="CudaCheck" Content="Use CUDA" IsChecked="False" VerticalAlignment="Center" ToolTip="Optional. CPU fallback is always available." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Inputs" FontSize="18" FontWeight="SemiBold" />
                    <ListBox x:Name="InputList" Grid.Row="1" Margin="0,10" SelectionMode="Extended" BorderThickness="0" />
                    <Button Grid.Row="2" Content="Remove selected" Click="RemoveSelected_Click" Margin="0" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ArchiveTitle" Text="No archive open" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="ArchiveSummary" Grid.Column="1" Foreground="#6B7280" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid x:Name="ArchiveList"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                            <DataGridTextColumn Header="Packed" Binding="{Binding Packed}" Width="100" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="150" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" Padding="20,10" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Text="7-Zip engine and GPUZIP codec ready" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar x:Name="OperationProgress" Grid.Column="1" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
